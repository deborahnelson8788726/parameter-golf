# Copy to .env and fill in. ALL values are optional for the demo.

# Leave unset to run the zero-setup SQLite demo (recommended for first run).
# Set to use a real Postgres database:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# "1" = allow the agent to write (add_doc). "0" = read-only deployment.
ALLOW_WRITES=1

# Where the JSONL audit trail is written.
AUDIT_LOG=mcp_audit.jsonl

# SQLite file path (demo mode only).
SQLITE_PATH=trinity_demo.db
